for((i=0;i<$1;i++))
do
echo "Enter $((i+1)) number:"
read nos[$i]
done
echo "Number entered are:"
for((i=0;i<$1;i++))
do
echo ${nos[$i]}
done
small=${nos[0]}
greater=${nos[0]}
for((i=0;i<$1;i++))
do
if [ ${nos[$i]} -lt $small ];
then
small=${nos[$i]}
elif [ ${nos[$i]} -gt $greater ];
then
greater=${nos[$i]}
fi
done
echo "Smallest number in an array is $small"
echo "Greatest number in an array is $greater"
